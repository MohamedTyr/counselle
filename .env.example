# Counselle configuration — copy to .env and fill in the blanks (ADR 0018).
# Every variable is read by config/settings.py with the COUNSELLE_ prefix.
# Values shown are the code defaults; required secrets are left blank.

# --- Models (ADR 0043: every live model call goes to Fireworks) ---
# REQUIRED outside development (boot fails without it). Secret.
COUNSELLE_FIREWORKS_API_KEY=
# Counselor Quick-mode model, "fireworks:<model>" form. Every live model must
# use the fireworks: prefix (boot fails otherwise) and have a price entry in
# COUNSELLE_MODEL_PRICES.
COUNSELLE_MODEL_COUNSELOR=fireworks:accounts/fireworks/models/deepseek-v4p1-flash
# Counselor Think-mode model. Disable Think honestly with
# COUNSELLE_RESPONSE_MODE_THINK_ENABLED.
COUNSELLE_MODEL_COUNSELOR_THINK=fireworks:accounts/fireworks/models/deepseek-v4p1-flash
# How hard each role reasons: none / low / medium / high. The model reasons by
# default, so every call sends one of these. Quick and Think counselor turns
# (and goal runs started in each) use the first two; titles and document
# summaries use CHEAP; the goal criteria writer and judge use GOAL.
COUNSELLE_REASONING_EFFORT_QUICK=low
COUNSELLE_REASONING_EFFORT_THINK=high
COUNSELLE_REASONING_EFFORT_CHEAP=none
COUNSELLE_REASONING_EFFORT_GOAL=high
# Labels served to the frontend in GET /v1/config response_modes.
COUNSELLE_MODEL_COUNSELOR_DISPLAY_NAME=DeepSeek V4.1 Flash
COUNSELLE_MODEL_COUNSELOR_THINK_DISPLAY_NAME=DeepSeek V4.1 Flash · Thinking
COUNSELLE_MODEL_COUNSELOR_THINK_PREVIEW=false
# Honest-disable switch: omit Think from /v1/config and reject explicit Think
# before claim/model call; never silently remap Think to Quick.
COUNSELLE_RESPONSE_MODE_THINK_ENABLED=true
# Cheap-tier model for low-stakes work
COUNSELLE_MODEL_CHEAP=fireworks:accounts/fireworks/models/deepseek-v4p1-flash
# Cheap model that auto-titles a chat from its first exchange (B4)
COUNSELLE_MODEL_TITLE=fireworks:accounts/fireworks/models/deepseek-v4p1-flash
# PARKED CDS admin pipeline (ADR 0038) -- still Gemini on Vertex, see --- GCP ---.
# CDS admin pipeline: one-shot PDF extraction model
COUNSELLE_MODEL_CDS_EXTRACT=google-vertex:gemini-3.1-flash-lite
# CDS extraction thinking budget: 0 disables thinking (default, current
# behaviour), -1 is the provider's automatic budget, positive = explicit
# token budget
COUNSELLE_MODEL_CDS_EXTRACT_THINKING_BUDGET=0
# Extra thinking budget for batches carrying a deliberation-hinted metric
# (currently H14 checkbox-grid selection state) only; 0 = use the thinking
# budget above for every batch (default, current behaviour)
COUNSELLE_MODEL_CDS_EXTRACT_DELIBERATION_BUDGET=0
# Takes precedence over the deliberation budget above for deliberation-hinted
# batches -- a thinking_level instead of a token budget, since the budget field
# is a coarse tier selector on gemini-3.1-flash-lite.
#
# HIGH is the shipped default and the configuration the tuning corpus measured
# at 99.01% accuracy; leaving this EMPTY turns deliberation off and drops
# accuracy to ~96.9% (cheaper: ~$0.09/doc vs ~$0.21/doc). Blank it deliberately
# if you want that trade -- do not blank it by accident.
COUNSELLE_MODEL_CDS_EXTRACT_DELIBERATION_LEVEL=HIGH
# CDS admin pipeline: per-file school+year detection model
COUNSELLE_MODEL_CDS_DETECT=google-vertex:gemini-3.1-flash-lite
# Total attempts (first try included) for every live model call; the openai SDK
# retries only 408/409/429/5xx and connection errors (see app/llm.py)
COUNSELLE_AGENT_MODEL_RETRY_ATTEMPTS=3
# Seconds a chat turn's streamed model request may wait for its next byte before it is retried
COUNSELLE_MODEL_READ_TIMEOUT_S=45
# Upper bound on model requests per agent turn
COUNSELLE_AGENT_MAX_MODEL_REQUESTS=80
# Hard token budget per agent turn
COUNSELLE_AGENT_MAX_TOTAL_TOKENS=2000000

# --- Chat (B4) ---
# Max length for the derived default title and the model-generated title
COUNSELLE_TITLE_MAX_LEN=60
# Stream the model's own reasoning to the student as `thinking` events. Not the
# Quick/Think selector. Keep it false: DeepSeek's reasoning is raw chain of
# thought with uncited guesses, which a student would read as fact (ADR 0043).
COUNSELLE_THINKING_STREAM=false
# Char threshold below which pre-tool narration routes to the thinking feed
# instead of streaming live (live-timeline editorial dial)
COUNSELLE_THINKING_THRESHOLD_CHARS=240

# --- Rate limiting (B4: in-process sliding windows; single-replica) ---
# Per-user message caps (a clarify answer spends a token)
COUNSELLE_TURNS_PER_HOUR=60
COUNSELLE_TURNS_PER_DAY=300
# Per-IP auth caps on login + forgot-password (brute-force / spam guard)
COUNSELLE_AUTH_ATTEMPTS_PER_WINDOW=10
COUNSELLE_AUTH_WINDOW_SECONDS=60

# --- Database ---
# REQUIRED: read-only DSN to the pipeline Postgres (counselle_ro role)
COUNSELLE_DB_RO_DSN=
# REQUIRED: read-write DSN for Counselle's own schema (sessions, users, workspace)
COUNSELLE_DB_APP_DSN=
# Admin DSN used only by scripts/seed_reader_db.py (every boot) and
# scripts/dev.py reset-db (local dev): owns roles/schema bootstrap for
# cds_library. Not read anywhere else -- the API itself never opens this DSN.
COUNSELLE_DB_ADMIN_DSN=
# Per-statement timeout for guarded queries, milliseconds
COUNSELLE_DB_STATEMENT_TIMEOUT_MS=8000
# Maximum rows any query may return
COUNSELLE_DB_ROW_CAP=500
# Connection-pool minimum size
COUNSELLE_DB_POOL_MIN=1
# Connection-pool maximum size
COUNSELLE_DB_POOL_MAX=5
# OPTIONAL: write DSN for the cds_library_app role (INSERT/SELECT/UPDATE on
# cds_library.* base tables). Under school-data-v3 this DSN drives the
# CollegeData facts crawler (COUNSELLE_FACTS_WORKER_ENABLED, Phase 1); the
# CDS admin extraction pipeline it used to drive exclusively is parked
# (ADR 0038, D8) and mutually exclusive with facts use -- never set
# COUNSELLE_CDS_WORKER_ENABLED=true while this DSN is used for facts. Unset =
# the app boots fine and the CDS admin router returns a clean 503.
COUNSELLE_DB_PIPELINE_DSN=
# Kill switch for the (parked) CDS admin surface itself, independent of the
# DSN above. Defaults false under school-data-v3 -- the CDS admin pipeline is
# parked, not the default write consumer of COUNSELLE_DB_PIPELINE_DSN anymore.
COUNSELLE_CDS_DATA_ENABLED=false

# --- Sessions ---
# Session checkpointer backend: "postgres" (durable) or "memory" (tests)
COUNSELLE_CHECKPOINTER=postgres
# Days before idle sessions are eligible for cleanup; unset = keep everything (default)
# COUNSELLE_SESSION_TTL_DAYS=30
# Max buffered SSE events per detached turn
COUNSELLE_AGENT_STREAM_BUFFER_SIZE=100000
# Process-wide byte budget shared across every live turn's ring buffer
COUNSELLE_STREAM_BUFFER_BYTES=268435456
# Watchdog timeout for one agent turn, seconds
COUNSELLE_AGENT_TURN_TIMEOUT_S=3600
# Timeout for MCP read operations, seconds
COUNSELLE_AGENT_MCP_READ_TIMEOUT_S=60.0
# Maximum tool-result chars allowed into model history before spill/read-back
COUNSELLE_AGENT_TOOL_RESULT_MAX_CHARS=20000
# Focused Answer's tool rounds before its tools are withdrawn
COUNSELLE_FOCUSED_ANSWER_MAX_TOOL_ROUNDS=4
# ...and its searches (web, a school's site, Reddit) per turn
COUNSELLE_FOCUSED_ANSWER_MAX_SEARCHES=2
# Bound on one partial-persist DB round at cancel/timeout, seconds
COUNSELLE_PERSIST_PARTIAL_TIMEOUT_S=5.0
# GET /v1/sessions/{id}/stream reattach endpoint (off = always 204)
COUNSELLE_REATTACH_ENABLED=true
# Global cap on concurrent detached turns across all sessions
COUNSELLE_MAX_CONCURRENT_TURNS=50
# Per-turn cap on concurrent stream consumers
COUNSELLE_MAX_CONSUMERS_PER_TURN=8

# --- CDS reader catalog and packet contract ---
COUNSELLE_DATA_CATALOG_REFRESH_SECONDS=3600
COUNSELLE_SUPPORTED_PACKET_EXTRACTOR_VERSIONS=gemini-native-pdf-v2,gemini-native-pdf-v5,gemini-routed-extraction-v7,gemini-routed-extraction-v8,counselle-cds-v1,human-review-v1
COUNSELLE_QUERY_DATABASE_MAX_BYTES=262144
# Maximum cells accepted by one visualization payload
COUNSELLE_VIZ_MAX_CELLS=600
# Maximum evidence records retained in the per-turn source registry
COUNSELLE_SOURCE_EVIDENCE_MAX_ITEMS=50

# --- Sources ---
# Tavily API key — required only when any external source is enabled.
# Either COUNSELLE_TAVILY_API_KEY or the bare TAVILY_API_KEY is honored.
COUNSELLE_TAVILY_API_KEY=
# Default on/off for the general web source
COUNSELLE_SOURCE_WEB_DEFAULT=true
# Default on/off for the Reddit source
COUNSELLE_SOURCE_REDDIT_DEFAULT=true
# Default on/off for the .edu source
COUNSELLE_SOURCE_EDU_DEFAULT=true
# Max results per external search call
COUNSELLE_SEARCH_MAX_RESULTS=5
# Max Reddit results per search — higher than the general cap above since a
# recurring pattern across many posts is the signal, not one anecdote
COUNSELLE_REDDIT_MAX_RESULTS=12

# --- GCP (only the PARKED CDS extraction system reads these, ADR 0038) ---
# Optional Vertex Express-mode API key (genai.Client(vertexai=True, api_key=...)).
# When blank, Counselle uses Application Default Credentials (ADC), the preferred
# authentication method for local development and production.
COUNSELLE_VERTEX_API_KEY=
# GCP project for Vertex AI; empty = use ambient ADC project
COUNSELLE_GOOGLE_CLOUD_PROJECT=
# Vertex AI region
COUNSELLE_GOOGLE_CLOUD_LOCATION=us-central1
# Standard (unprefixed) Google credentials var — path to a service-account JSON.
# This is NOT a Settings field; the Google SDKs read it directly. Alternative to
# the API key above.
GOOGLE_APPLICATION_CREDENTIALS=
# Internal escape hatch read directly off os.environ (not a Settings field with
# a default): set to "1" by an isolated subprocess launcher so that child
# process doesn't reload this repo's .env. Never set this by hand in a real
# .env — it disables env-file loading entirely.
# COUNSELLE_SETTINGS_NO_ENV_FILE=

# --- API ---
# Deploy environment label
COUNSELLE_ENVIRONMENT=development
# Bind host for the FastAPI service
COUNSELLE_API_HOST=127.0.0.1
# Bind port for the FastAPI service
COUNSELLE_API_PORT=8000
# Allowed CORS origins, JSON list. The documented Vite proxy works with this
# value; prod same-origin should leave this empty and set COUNSELLE_COOKIE_SECURE=true.
COUNSELLE_CORS_ORIGINS=["http://localhost:5173"]
# Serve the built frontend SPA from this same FastAPI process (ADR 0023
# same-origin prod serving). Dev leaves this false and runs Vite separately.
COUNSELLE_SERVE_SPA=false
# Directory holding the built SPA, only read when COUNSELLE_SERVE_SPA=true
COUNSELLE_SPA_DIST_DIR=frontend/dist
# SSE keepalive interval, seconds
COUNSELLE_SSE_KEEPALIVE_S=15
# Frozen SSE event-protocol version — do not change without an architecture discussion
COUNSELLE_PROTOCOL_VERSION=1

# --- Workspace ---
# Per-connection workspace-change-event queue depth
COUNSELLE_WORKSPACE_EVENT_QUEUE_SIZE=256
# Per-user workspace write rate limit, writes per minute
COUNSELLE_WORKSPACE_WRITES_PER_MINUTE=240
# Fall enrollment year visibly preselected when adding a school
COUNSELLE_CURRENT_ADMISSIONS_CYCLE_YEAR=2027
# Max chars of an uploaded document's excerpt kept for its summary
COUNSELLE_DOCUMENT_SUMMARY_EXCERPT_MAX_CHARS=8000
# Timeout for the document-summary model call, seconds
COUNSELLE_DOCUMENT_SUMMARY_TIMEOUT_S=8.0
# Timeout for PDF/DOCX text extraction on upload, seconds
COUNSELLE_DOCUMENT_EXTRACTION_TIMEOUT_S=8.0

# --- SAT practice (plans/sat-practice/plan.md §3.2/§4.1/§4.3/§4.6/§5.6/§6.4) ---
# The shared token-bucket rate for adapters/collegeboard/client.py, requests
# per second -- one bucket across both College Board API hosts.
COUNSELLE_SAT_FETCH_REQUESTS_PER_SECOND=4.0
# REQUIRED before any real fetch: the truthful, self-identifying User-Agent
# every College Board request carries -- its own setting from
# COUNSELLE_FACTS_CRAWL_USER_AGENT (two crawls, two hosts, two reasons to
# change). Replace <domain> with your own real, reachable domain -- the
# shipped placeholder below resolves to nothing and is REJECTED outside
# `development`, the same way COUNSELLE_FACTS_CRAWL_USER_AGENT is.
COUNSELLE_SAT_FETCH_USER_AGENT=CounselleBot/1.0 (+https://<domain>/bot)
# Where app/sat/bank.py reads the built question-bank file when it is not
# committed to the repo (plan §3.2, O5).
COUNSELLE_SAT_BANK_PATH=deploy/seed/sat/bank.jsonl.gz
# Upper clamp on a submitted/imported attempt's time_spent_seconds, seconds.
COUNSELLE_SAT_ATTEMPT_MAX_SECONDS=86400
# Hard cap on a PUT /v1/sat/progress import body, bytes -- below
# COUNSELLE_MAX_REQUEST_BODY_BYTES, so the student sees our own 413
# sentence rather than the middleware's bare 400 on a truncated body.
COUNSELLE_SAT_IMPORT_MAX_BYTES=12582912
# api/ratelimit.py's SAT write budget (attempts, bookmarks), per minute --
# separate from COUNSELLE_WORKSPACE_WRITES_PER_MINUTE.
COUNSELLE_SAT_WRITES_PER_MINUTE=120
# api/ratelimit.py's SAT read budget (GET /questions/{id}), per minute --
# the one endpoint that lets a signed-in account walk the whole licensed
# corpus in 3,767 requests.
COUNSELLE_SAT_QUESTION_READS_PER_MINUTE=600
# College Board's own Bluebook calculator embed, served through
# GET /v1/config. Its configuration is College Board's, not ours to change.
COUNSELLE_SAT_DESMOS_EMBED_URL=https://www.desmos.com/testing/collegeboard/graphing
# The mailto target for the practice Info dialog's "Report an issue" link.
COUNSELLE_SUPPORT_EMAIL=support@counselle.app

# --- CDS admin pipeline (parked, ADR 0038/D8 — kept importable, nothing here
# is mounted or started by default under school-data-v3) ---
# Kill switch for the in-process extraction-job poller. Queue state lives in
# cds_extractions (Postgres); turning this off just stops new claims. Defaults
# false now — mutually exclusive with facts use of COUNSELLE_DB_PIPELINE_DSN;
# never set true wherever that DSN drives the facts crawler.
COUNSELLE_CDS_WORKER_ENABLED=false
# How often the poller checks for a claimable extraction when idle, seconds
COUNSELLE_CDS_WORKER_POLL_SECONDS=3
# Concurrent extraction runs (bounded so extraction never starves chat traffic)
COUNSELLE_CDS_WORKER_CONCURRENCY=3
# Lease duration on a claimed extraction row, seconds (renewed at lease/3 while running)
COUNSELLE_CDS_EXTRACTION_LEASE_SECONDS=900
# Per-model-call timeout for one extraction/detection request, seconds
COUNSELLE_CDS_MODEL_TIMEOUT_SECONDS=180
# Hard cap on one uploaded CDS PDF, bytes
COUNSELLE_CDS_UPLOAD_MAX_BYTES=50000000

# --- Supplemental essay prompts (app/supplements) ---
# The daily sync of supplemental prompts from the public compilation page
# (COUNSELLE_SUPPLEMENTS_SOURCE_URL) into counselle.supplement_*. Runs inside
# the API process; a pass is due when none succeeded in the last
# COUNSELLE_SUPPLEMENTS_SYNC_INTERVAL_HOURS (24), and a failed one retries
# after COUNSELLE_SUPPLEMENTS_RETRY_MINUTES (60). Needs the Fireworks and
# app DB settings. Run one pass by hand: `uv run python -m app.supplements sync`.
COUNSELLE_SUPPLEMENTS_WORKER_ENABLED=true

# --- CollegeData facts store (school-data-v3, in-process crawler + admin
# dashboard) — the crawl-rate/identification block lands with Phase 1's
# fetch adapter (adapters/collegedata/fetch.py); worker orchestration
# (app/facts/crawl.py, jobs.py) and its own settings land with the rest of
# Phase 1's units. ---
# Kill switch for the in-process facts crawl worker (mirrors
# COUNSELLE_CDS_WORKER_ENABLED's shape). Defaults false until the worker
# (app/facts/jobs.py) ships.
COUNSELLE_FACTS_WORKER_ENABLED=false
# The shared token-bucket rate for adapters/collegedata/fetch.py, requests
# per second -- one bucket shared across COUNSELLE_FACTS_CRAWL_CONCURRENCY
# schools in flight. 1, not 2 (ADR 0038 R0's rate-limit mitigation, Q9).
COUNSELLE_FACTS_CRAWL_RPS=1.0
# How many schools app/facts/crawl.py is *designed* to run concurrently
# against the same shared token bucket above. 1 = strictly sequential
# requests. NOT YET CONSUMED: the current app/facts/crawl.py loop always
# runs sequentially regardless of this value -- kept for the near-future
# orchestration wiring, not dead config to delete (plan §4.1 names it as
# the real crawl-concurrency knob).
COUNSELLE_FACTS_CRAWL_CONCURRENCY=1
# Per-request httpx timeout for the CollegeData fetcher, seconds.
COUNSELLE_FACTS_CRAWL_REQUEST_TIMEOUT_S=20.0
# REQUIRED before any real crawl: the truthful, self-identifying User-Agent
# every collegedata.com request carries (ADR 0038 R0's identification
# mitigation). Replace <domain> with your own real, reachable domain --
# the shipped placeholder below resolves to nothing and is REJECTED: by
# Settings boot validation everywhere except `development`, and
# unconditionally by adapters/collegedata/fetch.py's FetchConfig (so no
# real crawl can ever run on it, in any environment).
COUNSELLE_FACTS_CRAWL_USER_AGENT=CounselleBot/1.0 (+https://<domain>/bot)
# How many distinct Next.js buildId rotations one crawl pass tolerates
# before aborting (adapters/collegedata/fetch.py).
COUNSELLE_FACTS_CRAWL_MAX_BUILD_ROTATIONS=3
# Hard ceiling on any single fetched response body from collegedata.com
# (after gunzip, if applicable), bytes -- adapters/collegedata/fetch.py is
# the one module ingesting raw third-party HTTP content, so every fetch
# path (robots.txt, sitemap XML, per-tab JSON) enforces this before handing
# bytes to a parser. Real traffic is far below this (the whole ~15,522-
# request pass moves ~100 MB combined; no single response is more than a
# few MB) -- this is a safety floor, not a tuning knob.
COUNSELLE_FACTS_CRAWL_MAX_RESPONSE_BYTES=20000000
# OPTIONAL: GET /v1/schools/explore's default and max "Load more" page size.
COUNSELLE_FACTS_EXPLORE_PAGE_SIZE=24
COUNSELLE_FACTS_EXPLORE_MAX_PAGE_SIZE=100
# OPTIONAL: runaway guard on ExploreResponse.total; must exceed the real
# browsable universe (~2,300-2,400 schools) so it never binds in practice.
COUNSELLE_FACTS_EXPLORE_MAX_COUNT=3000
# OPTIONAL: the sign-in reset notice (plan school-data-v3 §5.6, Q14). Set to
# the date the `counselle` schema was last rebuilt to surface a dismissible
# notice on /login and /register via the unauthenticated
# GET /v1/config/public; unset (the default) means no notice renders. Format
# YYYY-MM-DD.
COUNSELLE_DB_RESET_NOTICE_DATE=
# OPTIONAL: how many days after COUNSELLE_DB_RESET_NOTICE_DATE the notice
# keeps rendering.
COUNSELLE_DB_RESET_NOTICE_DAYS=30
# Hard cap on request bodies the API accepts (document uploads etc.), bytes.
# Default 16_777_216 = 15 MiB document limit + 1 MiB multipart headroom.
# Replaces the parked COUNSELLE_CDS_UPLOAD_MAX_BYTES as the middleware-level
# limit; a route's own limit (e.g. a document size cap) still applies first.
COUNSELLE_MAX_REQUEST_BODY_BYTES=16777216

# --- Auth (B3, ADR 0021) ---
# REQUIRED: the JWT cookie signing secret. MUST be at least 32 bytes (pyjwt 2.13
# warns below that). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
COUNSELLE_JWT_SECRET=
# The auth cookie name
COUNSELLE_COOKIE_NAME=counselle_auth
# Set true in production (HTTPS only) so the cookie carries the Secure flag
COUNSELLE_COOKIE_SECURE=false
# Auth cookie / JWT lifetime in seconds (locked at 30 days, no refresh)
COUNSELLE_JWT_LIFETIME_SECONDS=2592000
# Google OAuth (optional — the Google login route mounts only when both are set).
# Authorized redirect URI to register in the GCP console:
#   http://localhost:8000/v1/auth/google/callback
COUNSELLE_GOOGLE_OAUTH_CLIENT_ID=
COUNSELLE_GOOGLE_OAUTH_CLIENT_SECRET=
# OAuth CSRF state secret. Dev: falls back to COUNSELLE_JWT_SECRET when unset.
# PRODUCTION: set a DISTINCT secret (do not reuse the JWT secret). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# COUNSELLE_OAUTH_STATE_SECRET=
# Where the OAuth callback 302-redirects the SPA after setting the cookie
COUNSELLE_OAUTH_REDIRECT_URL=/
# Minimum accepted password length (security policy floor)
COUNSELLE_PASSWORD_MIN_LENGTH=8
# Self-service signup on/off
COUNSELLE_AUTH_SELF_SIGNUP_ENABLED=true
# Forgot-password flow on/off
COUNSELLE_PASSWORD_RESET_ENABLED=true
# Ceiling on the PATCH /v1/me `settings` jsonb blob. The auth dependency
# re-reads and decodes this column on every authenticated request, so an
# unbounded blob taxes the whole pool, not just the one PATCH.
COUNSELLE_USER_SETTINGS_MAX_BYTES=64000

# --- Email (B3) ---
# Transactional email provider; only "console" is implemented for MVP2
COUNSELLE_EMAIL_PROVIDER=console
# The From address on transactional email
COUNSELLE_EMAIL_FROM=noreply@counselle.app

# --- Observability ---
# Log level (DEBUG/INFO/WARNING/ERROR)
COUNSELLE_LOG_LEVEL=INFO
# Per-request token/cost accounting on/off
COUNSELLE_USAGE_ACCOUNTING=true
# Per-model token prices as JSON, keyed by the model name without the
# "fireworks:" prefix. Every live model needs an entry (boot fails otherwise) so
# the goal budget can price it. The code default is the highest Global rate
# Fireworks publishes for DeepSeek V4.1 Flash (est only); override with the
# account's confirmed price. Settings also supports long-context tiers.
# COUNSELLE_MODEL_PRICES={"accounts/fireworks/models/deepseek-v4p1-flash":{"input_per_1m":0.30,"output_per_1m":1.20}}

# --- Assets ---
# Directory holding versioned data assets; default is the repo's config/assets
COUNSELLE_ASSETS_DIR=config/assets
