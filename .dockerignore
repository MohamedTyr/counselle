# Secrets & VCS
.env
.git/
.gitignore

# Python build / cache artifacts
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
artifacts/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Frontend source/prototypes/backups — the backend runtime image does not serve
# the SPA build here (same-origin serving is a deferred B6 concern).
frontend/
frontend.backup-*/
mvp3-frontend/
node_modules/
build/
test-results/
playwright-report/

# Not needed at runtime: tests, plans, specs, docs, design mockups, eval reports
tests/
plans/
specs/
mockups/
docs/
evals/report-*

# Nested worktrees (1.2 GB of duplicated source) and local agent tooling
.worktrees/
.agents/
.claude/
.gstack/
.playwright-mcp/

# Design-iteration screenshot scratch
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.mov
*.webm
