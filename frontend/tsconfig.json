{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@librechat/client": ["src/vendor/librechat/client/index.ts"],
      "@librechat/client/*": ["src/vendor/librechat/client/*"],
      "~/*": ["src/vendor/librechat/app/*"],
      "@/*": ["src/*"],
      "librechat-data-provider": ["src/vendor/librechat-data-provider/index.ts"],
      "librechat-data-provider/*": ["src/vendor/librechat-data-provider/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
