# Counselle frontend — environment variables (Vite, VITE_-prefixed only).

# Transport seam selector (B5a).
#   http (default) — fetch-streaming SSE against /v1 (the real backend).
#   mock           — fixture replay (the contract-test harness, no backend).
VITE_TRANSPORT=http

# School logos in comparison tables (optional). Without this, logos fall back to
# keyless favicon CDNs, which are low-resolution for most .edu domains. For crisp
# HD logos, get a free *publishable* token at https://logo.dev and set it here
# (publishable tokens are safe to expose in the browser). Restart `npm run dev`.
# VITE_LOGO_DEV_TOKEN=pk_xxxxxxxxxxxxxxxxxxxx
